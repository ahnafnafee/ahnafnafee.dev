NEXT_PUBLIC_TWITTER_USERNAME=@twitter username
NEXT_PUBLIC_SITE_NAME=site name
NEXT_PUBLIC_SITE_URL=site url including "https://"

# Microsoft Clarity project id (heatmaps + session replay). Public by design —
# it ships in the client bundle. Unset means the tag never loads, which is also
# how dev behaves regardless, since Clarity is gated to production builds.
NEXT_PUBLIC_CLARITY_PROJECT_ID=clarity project id

# Read-count storage. Provisioned via Vercel Marketplace → Neon Postgres.
# `vercel env pull` will populate this locally once the integration is linked.
# Without it, the pageview API returns 0 and ordinary `yarn build` works.
# Vercel production builds require it to apply migrations before deployment;
# preview builds skip migrations. See docs/PAGEVIEWS.md.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
